# PostgreSQL Connection URL
# Examples:
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railway_db

# Render / Cloud PostgreSQL:
# DATABASE_URL=postgresql://username:password@dpg-xxxxx.render.com/railway_db

# Secret key for session security
SECRET_KEY=change-in-production-super-secret-key-12345

# Flask Debug Mode (True for local development, False for production)
FLASK_DEBUG=True
PORT=5000
